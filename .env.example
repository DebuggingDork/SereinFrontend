# Supabase: Project Settings > API. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Address of the Express API. Requests reach it through /api/backend on this origin.
BACKEND_URL=http://localhost:4000

# Public half of the gate pass key pair. Generate with `npm run keys:gate` in the backend.
GATE_PASS_PUBLIC_KEY=
